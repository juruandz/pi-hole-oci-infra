# Required variables
compartment_id     = "ocid1.compartment.oc1..example"  # Replace with your compartment OCID
region            = "eu-stockholm-1"
availability_domain = ""  # Empty = first AD in the region. Set an explicit AD name (e.g. "YbUn:EU-STOCKHOLM-1-AD-1") if E2.1.Micro capacity is unavailable.

# Security
allowed_ip        = "YOUR_IP/32"  # Replace with your IP address in CIDR notation (e.g., "78.157.68.185/32")
ssh_public_key    = file("path/to/your/ssh-key.pub")  # Replace with path to your SSH public key file
ssh_private_key   = file("path/to/your/ssh-key")      # Replace with path to your SSH private key file (used for provisioning)
ddns_host         = "yourhost.com"  # Replace with your DDNS hostname (leave empty "" if not using DDNS)

# Optional overrides
# instance_shape   = "VM.Standard.E2.1.Micro"  # Default value, can be changed if needed